<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/size_16dp">

        <View
            android:id="@+id/vItemBg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_88dp"
            android:background="@drawable/viwe_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivItemIcon"
            android:layout_width="@dimen/size_40dp"
            android:layout_height="@dimen/size_40dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:padding="@dimen/size_8dp"
            android:src="@drawable/calendar"
            app:layout_constraintBottom_toBottomOf="@id/vItemBg"
            app:layout_constraintEnd_toEndOf="@id/vItemBg"
            app:layout_constraintTop_toTopOf="@id/vItemBg"
            app:tint="@color/primary_Button" />

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:textStyle="bold"
            android:textColor="@color/title_text"
            android:textSize="@dimen/size_text16sp"
            app:layout_constraintEnd_toStartOf="@id/ivItemIcon"
            app:layout_constraintStart_toStartOf="@id/vItemBg"
            app:layout_constraintTop_toTopOf="@id/vItemBg" />

        <TextView
            android:id="@+id/tvItemTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/hit500_text"
            android:textSize="@dimen/size_text12sp"
            app:layout_constraintEnd_toEndOf="@id/tvItemTitle"
            app:layout_constraintStart_toStartOf="@id/tvItemTitle"
            app:layout_constraintTop_toBottomOf="@id/tvItemTitle" />


</androidx.constraintlayout.widget.ConstraintLayout>