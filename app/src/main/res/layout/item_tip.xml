<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="@dimen/size_8dp">

    <View
        android:id="@+id/vTipItemBg"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_72dp"
        android:background="@drawable/viwe_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivTipIcon"
        android:layout_width="@dimen/size_32dp"
        android:layout_height="@dimen/size_32dp"
        android:layout_marginEnd="@dimen/size_16dp"
        android:src="@drawable/tips"
        app:layout_constraintBottom_toBottomOf="@+id/vTipItemBg"
        app:layout_constraintEnd_toEndOf="@id/vTipItemBg"
        app:layout_constraintTop_toTopOf="@+id/vTipItemBg"
        app:tint="@color/primary_Button" />

    <TextView
        android:id="@+id/tvTipText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_16dp"
        android:textColor="@color/title_text"
        android:textSize="@dimen/size_text16sp"
        android:textStyle="bold"
        android:gravity="start|center_vertical"
        app:layout_constraintBottom_toBottomOf="@+id/vTipItemBg"
        app:layout_constraintEnd_toStartOf="@+id/ivTipIcon"
        app:layout_constraintStart_toStartOf="@+id/vTipItemBg"
        app:layout_constraintTop_toTopOf="@id/vTipItemBg" />

</androidx.constraintlayout.widget.ConstraintLayout>
