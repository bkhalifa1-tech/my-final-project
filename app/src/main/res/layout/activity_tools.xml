<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    tools:context="com.example.myfinalproject.ToolsActivity">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/size_20dp"
        app:layout_constraintTop_toTopOf="parent">


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="أدواتي "
            android:textColor="@color/title_text"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/size_20dp"
            android:paddingBottom="@dimen/size_32dp">

            <TextView
                android:id="@+id/tvToolsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_basic_tools"
                android:textColor="@color/title_text"
                android:textSize="@dimen/title_text24sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:layout_marginTop="@dimen/size_32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvToolsDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tools_desc"
                android:textColor="@color/title_text"
                android:textSize="@dimen/size_text16sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:layout_marginTop="@dimen/size_8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvToolsTitle" />






            <View
                android:id="@+id/vTipsBg"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_150dp"
                android:layout_marginTop="@dimen/size_16dp"
                android:background="@drawable/viwe_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vEmergencyBg" />

            <View
                android:id="@+id/vTipIcon"
                android:layout_width="@dimen/size_56dp"
                android:layout_height="@dimen/size_56dp"
                android:layout_marginTop="@dimen/size_32dp"
                android:background="@drawable/image_profile"
                android:backgroundTint="@color/shape_color"
                app:layout_constraintEnd_toEndOf="@id/vTipsBg"
                app:layout_constraintStart_toStartOf="@id/vTipsBg"
                app:layout_constraintTop_toTopOf="@id/vTipsBg" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/tips"
                app:layout_constraintBottom_toBottomOf="@id/vTipIcon"
                app:layout_constraintEnd_toEndOf="@id/vTipIcon"
                app:layout_constraintStart_toStartOf="@id/vTipIcon"
                app:layout_constraintTop_toTopOf="@id/vTipIcon" />
            <TextView
                android:id="@+id/tvTipsLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:gravity="center"
                android:text="@string/weekly_tips_tool"
                android:textColor="@color/hit500_text"
                android:textSize="@dimen/size_text16sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                app:layout_constraintTop_toBottomOf="@id/vTipIcon"
                app:layout_constraintStart_toStartOf="@id/vTipsBg"
                app:layout_constraintEnd_toEndOf="@id/vTipsBg" />

            <View
                android:id="@+id/vEmergencyBg"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_150dp"
                android:layout_marginTop="@dimen/size_32dp"
                android:background="@drawable/viwe_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvToolsDesc" />

            <View
                android:id="@+id/vEmIcon"
                android:layout_width="@dimen/size_56dp"
                android:layout_height="@dimen/size_56dp"
                android:layout_marginTop="@dimen/size_32dp"
                android:background="@drawable/image_profile"
                android:backgroundTint="@color/shape_color"
                app:layout_constraintEnd_toEndOf="@id/vEmergencyBg"
                app:layout_constraintStart_toStartOf="@id/vEmergencyBg"
                app:layout_constraintTop_toTopOf="@id/vEmergencyBg" />


            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/phone"
                app:layout_constraintBottom_toBottomOf="@id/vEmIcon"
                app:layout_constraintEnd_toEndOf="@id/vEmIcon"
                app:layout_constraintStart_toStartOf="@id/vEmIcon"
                app:layout_constraintTop_toTopOf="@id/vEmIcon" />

            <TextView
                android:id="@+id/tvEmLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:gravity="center"
                android:text="@string/emergency_numbers"
                android:textColor="@color/hit500_text"
                android:textSize="@dimen/size_text16sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                app:layout_constraintEnd_toEndOf="@id/vEmergencyBg"
                app:layout_constraintStart_toStartOf="@id/vEmergencyBg"
                app:layout_constraintTop_toBottomOf="@id/vEmIcon" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_72dp"
        android:background="@color/white"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingTop="@dimen/size_8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:contentDescription="@null"
                android:src="@drawable/home" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textSize="@dimen/size_text11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAppointments"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:contentDescription="@null"
                android:src="@drawable/calendar" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_appointments"
                android:textSize="@dimen/size_text11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTools"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:contentDescription="@null"
                android:src="@drawable/magic_wand"
                app:tint="@color/primary_Button" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_tools"
                android:textColor="@color/primary_Button"
                android:textSize="@dimen/size_text11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:contentDescription="@null"
                android:src="@drawable/user" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings"
                android:textSize="@dimen/size_text11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
