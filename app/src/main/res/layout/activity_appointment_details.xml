<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    tools:context="com.example.myfinalproject.AppointmentDetailsActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_64dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/size_20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/size_32dp"
            android:layout_height="@dimen/size_32dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:src="@drawable/rightarrow" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/appointment_details"
            android:textColor="@color/title_text"
            android:textSize="@dimen/size_text24sp"
            android:textStyle="bold"
            android:fontFamily="serif" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_20dp">

            <View
                android:id="@+id/vMainInfoBg"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_210dp"
                android:background="@drawable/viwe_background"
                android:padding="@dimen/size_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDetailHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_32dp"
                android:fontFamily="serif"
                android:textColor="@color/hit600_text"
                android:textSize="@dimen/size_text16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/vMainInfoBg"
                app:layout_constraintStart_toStartOf="@id/vMainInfoBg"
                app:layout_constraintTop_toTopOf="@id/vMainInfoBg" />

            <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_40dp"
                android:layout_margin="@dimen/size_56dp"
                android:layout_marginTop="@dimen/size_8dp"
                android:background="@drawable/edit_background"
                android:drawableStart="@drawable/calendar"
                android:drawablePadding="@dimen/size_8dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/size_16dp"
                android:textColor="@color/title_text"
                android:textSize="@dimen/size_text16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/vMainInfoBg"
                app:layout_constraintStart_toStartOf="@id/vMainInfoBg"
                app:layout_constraintTop_toTopOf="@id/tvDetailHeading" />

            <TextView
                android:id="@+id/tvDetailTime"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_40dp"
                android:layout_marginHorizontal="@dimen/size_56dp"
                android:layout_marginTop="@dimen/size_16dp"
                android:background="@drawable/edit_background"
                android:drawableStart="@drawable/clock"
                android:drawablePadding="@dimen/size_8dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/size_16dp"
                android:textColor="@color/title_text"
                android:textSize="@dimen/size_text16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/vMainInfoBg"
                app:layout_constraintStart_toStartOf="@id/vMainInfoBg"
                app:layout_constraintTop_toBottomOf="@id/tvDetailDate" />

            <View
                android:id="@+id/vDoctorBg"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_56dp"
                android:layout_marginTop="@dimen/size_16dp"
                android:background="@drawable/viwe_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vMainInfoBg" />

            <TextView
                android:id="@+id/tvDetailDoctor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/hit200_text"
                android:textSize="@dimen/size_text16sp"
                android:padding="@dimen/size_16dp"
                app:layout_constraintBottom_toBottomOf="@+id/vDoctorBg"
                app:layout_constraintEnd_toEndOf="@id/vDoctorBg"
                app:layout_constraintStart_toStartOf="@id/vDoctorBg"
                app:layout_constraintTop_toTopOf="@id/vDoctorBg" />


            <View
                android:id="@+id/vLocationBg"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_56dp"
                android:layout_marginTop="@dimen/size_16dp"
                android:background="@drawable/viwe_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vDoctorBg" />


            <TextView
                android:id="@+id/tvLocationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/hit600_text"
                android:textSize="@dimen/size_text16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="@dimen/size_16dp"
                app:layout_constraintBottom_toBottomOf="@+id/vLocationBg"
                app:layout_constraintEnd_toEndOf="@id/vLocationBg"
                app:layout_constraintStart_toStartOf="@id/vLocationBg"
                app:layout_constraintTop_toTopOf="@id/vLocationBg" />


            <Button
                android:id="@+id/btnEditApp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_56dp"
                android:layout_marginTop="@dimen/size_48dp"
                android:background="@drawable/button_selector"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/edit_appointment_btn"
                android:textColor="@color/white"
                android:textSize="@dimen/size_text16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:layout_constraintTop_toBottomOf="@id/vLocationBg" />

            <Button
                android:id="@+id/btnDeleteApp"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_56dp"
                android:layout_marginTop="@dimen/size_16dp"
                android:background="@drawable/role_card_unselected"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/delete_appointment_btn"
                android:textColor="@color/primary_Button"
                android:textSize="@dimen/size_text16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnEditApp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
